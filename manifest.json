{
  "manifest_version": 3,
  "name": "Watch & Read – keep videos playing while reading comments",
  "short_name": "Watch & Read",
  "version": "1.0.0",
  "description": "On Facebook and Instagram, opening the comments floats the video in a small window that keeps playing while you read.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["*://*.facebook.com/*", "*://*.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Watch & Read",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "float-video": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Float the playing video and keep it playing"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "*://*.instagram.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.facebook.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
